{
  "manifest_version": 3,
  "name": "NSE Market Events",
  "version": "1.0.0",
  "description": "NSE holidays, cash FII/DII, India VIX, and index results from bundled data/results.json. No Kite. Load unpacked.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Events"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.nseindia.com/*",
    "https://query1.finance.yahoo.com/*"
  ]
}
