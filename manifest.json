{
  "manifest_version": 3,
  "name": "Market Events",
  "version": "1.0.1",
  "description": "NSE holidays, FII/DII, next macro event, per-index impact, live NIFTY/SENSEX/BANKNIFTY. No Kite.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Events",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.nseindia.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
