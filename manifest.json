{
  "manifest_version": 3,
  "name": "Market Pulse",
  "version": "1.1.0",
  "description": "Compact Indian index pulse: live NIFTY/SENSEX/BANKNIFTY, VIX, FII/DII, next event, constituent risk. No account, no Kite.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Pulse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://www.nseindia.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
